#!/usr/bin/env bash
# Prints one QR code that pairs Mio with this PC: the Tailscale address plus the AI gateway
# token and, when Pianissimo is installed, its transcription token. Nothing is written to disk.
# Usage: mio-pair            show the QR code
#        mio-pair --text     also show the values as text, for typing them in by hand
set -euo pipefail

fail() { printf 'FEL: %s\n' "$1" >&2; exit 1; }
show_text=false
case "${1:-}" in
    "") ;;
    --text) show_text=true ;;
    *) fail "Okänt val: $1. Använd inget val, eller --text." ;;
esac

command -v qrencode >/dev/null || fail "qrencode saknas: sudo pacman -S qrencode"
gateway=/opt/mio-gateway/mio-gateway
[[ -x $gateway ]] || fail "AI-gatewayen är inte installerad. Kör server/install.sh först."
tailscale status >/dev/null 2>&1 || fail "Tailscale är inte inloggat: sudo tailscale up"
host="$(tailscale status --json | "$gateway" tailscale-host)"
[[ $host =~ ^[a-z0-9-]+(\.[a-z0-9-]+)+$ ]] || fail "Hittar inte datorns Tailscale-namn. Är MagicDNS och HTTPS på i Tailscale?"

sudo -v || fail "sudo behövs för att läsa tokens."
sudo test -f /etc/mio-gateway/gateway.env || fail "AI-gatewayen är inte installerad. Kör server/install.sh först."
# Pianissimo is optional for pairing. Read only files that exist: with pipefail, a missing
# file used to end the script silently before any QR code was shown.
files=(/etc/mio-gateway/gateway.env)
if sudo test -f /etc/mio-transcription.conf; then
    files+=(/etc/mio-transcription.conf)
else
    echo "OBS: Pianissimo är inte installerat än, så koden innehåller bara AI." >&2
    echo "     Installera transcription-server/install.sh och kör mio-pair igen för att få med transkriptionen." >&2
fi

# Secrets travel only through this pipe: never argv, environment, files or the terminal (unless --text).
payload="$(sudo cat "${files[@]}" | "$gateway" pairing-payload "$host")"

printf '%s' "$payload" | qrencode -t ansiutf8 -m 2 -l M
echo "Skanna i Mio: Inställningar → Parning → Skanna QR-kod."
echo "Dator: $host (AI på port 8443$( (( ${#files[@]} == 2 )) && echo ', Pianissimo på 443' || echo '; Pianissimo saknas än'))"
if $show_text; then
    printf '%s' "$payload" | "$gateway" pairing-text
    echo "Stäng terminalen efteråt så att tokens inte ligger kvar på skärmen."
fi
unset payload
