# Mall för /etc/mio-gateway/gateway.env. install.sh skapar filen åt dig; lägg aldrig hemligheter i Git.
# Standard sedan 2026-11-20: Mistral Small 4 för frågor och vardag, Large 4 (resonerar) bara för lektioner.
MISTRAL_API_KEY=
MIO_GATEWAY_TOKEN=
MIO_AI_PROVIDER=mistral
MIO_AI_MODEL=mistral-small-2603
MIO_AI_TASK_PROFILES={"lesson":{"model":"mistral-large-4-0"}}
# Skrivs bara efter ett godkänt prov (install.sh eller Prova i Mio Kontroll).
MIO_APPROVED_CANDIDATES=
MIO_REQUESTS_PER_MINUTE=10
# Groqs gratisnivå: 8 000 token per minut, räknat som prompt + reserverat svar. Gäller bara Groq.
MIO_TOKENS_PER_MINUTE=8000
# Mistral har ingen sådan minutgräns. Tomt = ingen anpassning.
MIO_TOKENS_PER_MINUTE_MISTRAL=
# Tomt eller 0 = ingen tokengräns per dygn i Mio (Groqs gratisnivå: sätt 190000).
MIO_TOKENS_PER_DAY=
# Tomt eller 0 = ingen daglig anropsgräns.
MIO_REQUESTS_PER_DAY=
MIO_LESSON_INTERVAL_SECONDS=60
PORT=8787
# För Groq i stället: GROQ_API_KEY=, MIO_AI_PROVIDER=groq, MIO_AI_MODEL=qwen/qwen3.8-27b.
# Sätts av systemd-tjänsten: MIO_STATE_FILE=/var/lib/mio-gateway/counters.json
# och MIO_USAGE_FILE=/var/lib/mio-gateway/usage.json
