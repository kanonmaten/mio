# Kopiera till .env privat på servern; lägg aldrig hemligheter i Git.
NVIDIA_API_KEY=
MIO_GATEWAY_TOKEN=
MIO_AI_PROVIDER=nvidia
MIO_AI_MODEL=deepseek-ai/deepseek-v4.1-flash
MIO_LESSON_INTERVAL_SECONDS=60
# Andra leverantörer och hemlighetsnamn: PROVIDERS.md
PORT=8787
MIO_REQUESTS_PER_MINUTE=20
# Tomt eller 0 = ingen daglig gräns i Mio. Ange ett heltal för att sätta en.
MIO_REQUESTS_PER_DAY=
