# Mall för /etc/mio-gateway/gateway.env. install.sh skapar filen åt dig; lägg aldrig hemligheter i Git.
GROQ_API_KEY=
MIO_GATEWAY_TOKEN=
MIO_AI_PROVIDER=groq
MIO_AI_MODEL=qwen/qwen3.8-27b
MIO_REQUESTS_PER_MINUTE=3
# Groqs gratisnivå: 200 000 token per dygn. Tomt eller 0 = ingen tokengräns i Mio.
MIO_TOKENS_PER_DAY=190000
# Tomt eller 0 = ingen daglig anropsgräns.
MIO_REQUESTS_PER_DAY=
MIO_LESSON_INTERVAL_SECONDS=60
PORT=8787
# Sätts av systemd-tjänsten: MIO_STATE_FILE=/var/lib/mio-gateway/counters.json
