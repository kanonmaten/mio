[Unit]
Description=Mio privat AI-gateway (Groq)
Documentation=file:///opt/mio-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mio-gateway
Group=mio-gateway
# Read by systemd as root before privileges drop; the file itself stays root-only (0600).
EnvironmentFile=/etc/mio-gateway/gateway.env
Environment=MIO_STATE_FILE=/var/lib/mio-gateway/counters.json
ExecStart=/usr/bin/node /opt/mio-gateway/src/server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=mio-gateway
StateDirectoryMode=0700
UMask=0077

# Hardening: the gateway only needs outbound HTTPS to Groq and a loopback listener.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Node raises its own file limit at start; deny quietly instead of killing on a filtered call.
SystemCallErrorNumber=EPERM
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
