[Unit]
Description=Mio privat AI-gateway
Documentation=file:///opt/mio-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mio-gateway
Group=mio-gateway
# Read by systemd as root before privileges drop; the file itself stays root-only (0600).
EnvironmentFile=/etc/mio-gateway/gateway.env
Environment=MIO_STATE_FILE=/var/lib/mio-gateway/counters.json
# Monthly token counts per task and model for the credit meter in Mio Kontroll. Numbers only.
Environment=MIO_USAGE_FILE=/var/lib/mio-gateway/usage.json
ExecStart=/opt/mio-gateway/mio-gateway
Restart=on-failure
RestartSec=5
StateDirectory=mio-gateway
StateDirectoryMode=0700
UMask=0077

# Hardening: the gateway only needs outbound HTTPS to its AI provider and a loopback listener.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Deny a filtered call quietly instead of killing the service.
SystemCallErrorNumber=EPERM
# The Rust gateway uses about 6 MB; the cap only stops a runaway.
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
